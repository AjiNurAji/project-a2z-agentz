# ============================================================
# A2Z Agentz — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or expose real secrets.
# ============================================================

# --- DATABASE LAYER ---
# PostgreSQL connection string (contains db/user/pass). Single source of truth.
POSTGRES_URI=<YOUR_POSTGRES_URI>

# --- BLOCKCHAIN NETWORK ---
# Multi-RPC fallback for Base Mainnet (rotates automatically if one fails).
# All four must resolve to chainId 8453. Fill with your own RPC keys.
BASE_RPC_1=https://base-mainnet.g.alchemy.com/v2/<YOUR_KEY>
BASE_RPC_2=https://base-mainnet.g.alchemy.com/v2/<YOUR_KEY_2>
BASE_RPC_3=https://base-mainnet.g.alchemy.com/v2/<YOUR_KEY_3>
BASE_RPC_4=https://base-mainnet.g.alchemy.com/v2/<YOUR_KEY_4>

# Testnet node for safe smart contract deployment and testing.
BASE_SEPOLIA_RPC_1=https://base-sepolia.g.alchemy.com/v2/<YOUR_KEY>

# Active network selector used by routing logic (DUAL-HOME SSOT).
#   base        -> Base Mainnet (chain 8453)
#   base_sepolia-> Base Sepolia (chain 84532, default for live demos)
# All RPC / router / vault / explorer resolution follows this single switch.
ACTIVE_NETWORK=base_sepolia

# --- DUAL-HOME SAFETY INTERLOCK (mainnet broadcasts) ---
# AGENT_B_DRY_RUN=1 -> NEVER broadcast on mainnet (safe demo mode, raises).
AGENT_B_DRY_RUN=1
# MAINNET_CONFIRM=1 -> explicit double-check gate required before ANY mainnet
#   broadcast. Without this, safety_interlock() refuses to send real tx.
MAINNET_CONFIRM=0

# --- VAULT SEGREGATION (per-network wallets) ---
# Testnet vault (used when ACTIVE_NETWORK=base_sepolia):
TESTNET_VAULT_ADDRESS=<YOUR_TESTNET_VAULT_ADDRESS>
TESTNET_VAULT_PRIVATE_KEY=<YOUR_TESTNET_VAULT_PRIVATE_KEY>

# --- REAL ON-CHAIN EXECUTION (AGENT B) ---
# Master kill-switch for broadcasting REAL transactions.
#   0 = safe mode (no broadcast, mock/dry-run only)
#   1 = LIVE (Agent B will broadcast real signed tx to the chain)
# Default to 0 in production until you have verified VAULT_ADDRESS + budget.
AGENT_B_REAL_EXECUTION=0

# Strict slippage band for DEX swaps (basis points). Enforced range 50-100
# (0.5% - 1.0%). Computed from getAmountsOut; applies to both BUY and SELL.
AGENT_B_SWAP_SLIPPAGE_BPS=100

# Recipient address for proof-of-execution micro-transfers.
# MUST be a clean EOA that accepts native ETH.
# DO NOT use an EIP-7702 delegated EOA (e.g. adityamlna.base.eth / 0xD471...)
# — it reverts on native value transfer on Base mainnet.
# Verified clean EOA (operator): <YOUR_VAULT_ADDRESS>
VAULT_ADDRESS=<YOUR_VAULT_ADDRESS>

# Micro-transfer amount for the proof-of-execution receipt (in ETH).
MICRO_TX_ETH=0.00001

# Hard gas-price ceiling (Gwei). Broadcast is skipped if estimated maxFee
# exceeds this. Set 0 to disable the cap (not recommended).
MAX_GAS_PRICE_GWEI=5

# --- CRYPTO CREDENTIALS ---
# Hot wallet keys for automated on-chain execution and transaction signatures.
PRIVATE_KEY=0x<YOUR_PRIVATE_KEY>
AGENT_A_PUBLIC_KEY=0x<YOUR_PUBLIC_KEY>

# --- OSINT & SOCIAL SIGNALS ---
# Neynar API for real-time Farcaster data ingestion.
NEYNAR_API_KEY=<YOUR_NEYNAR_API_KEY>

# AI BRAIN (AGENT A) — AMD MI300X vLLM
# The backend reads AI_ENDPOINT (OpenAI-compatible base URL served by vLLM on ROCm).
# When using Cloudflare Quick Tunnel: https://<random-subdomain>.trycloudflare.com/v1
# Leave empty to disable Agent A inference (system-status reports "not_configured").
AI_ENDPOINT=
AI_API_KEY=<YOUR_VLLM_API_KEY>
AI_MODEL=Llama/Llama2.5-72B-Instruct-AWQ
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=1024

# NOTE: Agent A configuration uses the AI_* variables above as the single
# source of truth (AI_ENDPOINT, AI_API_KEY, AI_MODEL, AI_TEMPERATURE, AI_MAX_TOKENS).
# Legacy AGENT_A_* aliases have been removed — set AI_* instead.

# GUARDRAIL VALIDATOR (AGENT B)
# Secondary AI agent used as a final anti-hallucination check before execution.
AGENT_B_ENDPOINT=https://api.fireworks.ai/inference/v1
AGENT_B_MODEL=accounts/fireworks/models/deepseek-v4-pro
AGENT_B_API_KEY=<YOUR_AGENT_B_API_KEY>
AGENT_B_TEMPERATURE=0.1
AGENT_B_MAX_TOKENS=1024

# --- SECURITY GATES ---
# Anti-rug and honeypot security screening URL for Base Mainnet (Chain ID 8453).
GOPLUS_API_URL=https://api.gopluslabs.io/api/v1/token_security/8453
GOPLUS_API_KEY=<YOUR_GOPLUS_API_KEY>

# --- TRANSACTION SIMULATION ---
# Sandbox simulation keys for testing smart contract calls before hitting Mainnet.
TENDERLY_ACCESS_KEY=<YOUR_TENDERLY_ACCESS_KEY>
TENDERLY_ACCOUNT_SLUG=<YOUR_TENDERLY_ACCOUNT_SLUG>
TENDERLY_PROJECT_SLUG=<YOUR_TENDERLY_PROJECT_SLUG>

# --- AUTH & API SECURITY ---
# JWT signing secret (must be a strong random 32+ character string).
JWT_SECRET=<YOUR_JWT_SECRET_MIN_32_CHARS>
# Bearer token for agent-to-API authentication.
API_KEY=<YOUR_API_KEY>
# Admin token for read-only demo/admin endpoints (passed as X-Admin-Token).
ADMIN_TOKEN=<YOUR_ADMIN_TOKEN>
# Allowed CORS origin for the dashboard/frontend.
FRONTEND_ORIGIN=http://localhost:3000

# --- AGENT A SCOUT THRESHOLDS ---
# Minimum LLM score for Agent A to pass a target to Agent B.
AGENT_A_LLM_THRESHOLD=60
# Strict Alpha Filter: tokens below these thresholds are dropped before inference.
AGENT_A_MIN_LIQUIDITY_USD=5000
AGENT_A_MIN_VOLUME_24H=1000
AGENT_A_MIN_FDV=50000

# --- AGENT B VAULT CONFIG ---
# Concurrency: how many queued tasks Agent B processes per worker tick.
AGENT_B_CONCURRENCY=1
# Per-execution token value cap (fallback when LLM fails to return amount_usd).
AGENT_B_MAX_TX_USD=0.50
# Auto-discover model from /v1/models (0=off, use AGENT_B_MODEL as-is).
AGENT_B_MODEL_AUTO_DISCOVER=0
AGENT_B_MODEL_DISCOVER_TIMEOUT=10
# Kill-switch: bypass GoPlus security gate (0=normal, 1=skip for demos).
AGENT_B_SKIP_GOPLUS=0
# Take-profit: sell held tokens when price increases by this %.
AGENT_B_PROFIT_PCT=30

# --- INFRASTRUCTURE ---
# Base chain ID (8453=mainnet, 84532=sepolia).
BASE_CHAIN_ID=8453
# RPC call timeout in seconds.
BASE_RPC_TIMEOUT=10
# ChromaDB persistent storage path.
CHROMA_PATH=.chroma_db
# Platform hint for serverless deployments (vercel|serverless).
A2Z_PLATFORM=
# Gnosis Safe Transaction Service URL (optional, for multisig vaults).
GNOSIS_SAFE_API_URL=
