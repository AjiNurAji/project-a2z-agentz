# ============================================================
# A2Z Agentz (AaaS) — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or expose real secrets.
# Mnemonic: AaaS = Agent-as-a-Service. No AMD hackathon relic.
# ============================================================

# --- DATABASE (Neon Postgres — single source of truth) ---
# Neon connection string (already includes ?sslmode=require).
POSTGRES_URI=<YOUR_NEON_POSTGRES_URI>

# --- BLOCKCHAIN NETWORK (Base) ---
# Multi-RPC fallback for Base Mainnet (rotates automatically if one fails).
BASE_RPC_1=<YOUR_BASE_RPC_1>
BASE_RPC_2=<YOUR_BASE_RPC_2>
BASE_RPC_3=<YOUR_BASE_RPC_3>
BASE_RPC_4=<YOUR_BASE_RPC_4>
BASE_RPC_TIMEOUT=10
# Sepolia RPC (for testnet demo / safe testing).
BASE_SEPOLIA_RPC=<YOUR_BASE_SEPOLIA_RPC>
BASE_SEPOLIA_RPC_1=<YOUR_BASE_SEPOLIA_RPC_1>
BASE_SEPOLIA_RPC_2=<YOUR_BASE_SEPOLIA_RPC_2>
# Base chain ID (8453=mainnet, 84532=sepolia).
BASE_CHAIN_ID=8453
# Active network selector: base | base_sepolia
ACTIVE_NETWORK=base

# --- VAULT (hot wallet for automated execution) ---
# Production vault (Base mainnet).
VAULT_ADDRESS=<YOUR_VAULT_ADDRESS>
VAULT_PRIVATE_KEY=<YOUR_VAULT_PRIVATE_KEY>
# Testnet vault (Base Sepolia) — for safe demo / testing.
TESTNET_VAULT_ADDRESS=<YOUR_TESTNET_VAULT_ADDRESS>
TESTNET_VAULT_PRIVATE_KEY=<YOUR_TESTNET_VAULT_PRIVATE_KEY>
# Recipient for proof-of-execution micro-transfer (clean EOA, accepts ETH).
MICRO_TX_ETH=0.00001

# --- CRYPTO CREDENTIALS ---
PRIVATE_KEY=<YOUR_PRIVATE_KEY>

# --- SELF-CUSTODIAL WALLET GEN (P3) ---
# 32-byte hex used to AES-256-GCM encrypt per-user wallets. Generate:
#   openssl rand -hex 32
WALLET_ENC_SECRET=<YOUR_WALLET_ENC_SECRET_32_BYTE_HEX>

# --- P1: PLATFORM FEE (skimmed from realized sell proceeds) ---
# 20 bps = 0.2%. Sent to ADMIN_VAULT_ADDRESS.
PLATFORM_FEE_BPS=20
ADMIN_VAULT_ADDRESS=<YOUR_ADMIN_VAULT_ADDRESS>

# --- P2: USER CONTROL (auto-sell toggle) ---
AGENT_B_AUTO_SELL=0

# --- P4: SUBSCRIPTION / PAYMENT (crypto-native) ---
PAYMENT_VAULT_ADDRESS=<YOUR_PAYMENT_VAULT_ADDRESS>
USDC_BASE_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
SUPPORT_EMAIL=archbusins@gmail.com
SUPPORT_WEBSITE=https://archbusins.web.id

# --- P6: SIWE (Sign-In-With-Ethereum) ---
# Domain shown in the SIWE message (must match the frontend origin).
SIWE_DOMAIN=project-a2z-agentz-gamma.vercel.app

# --- AUTH & API SECURITY ---
# JWT signing secret (strong random 32+ char string).
JWT_SECRET=<YOUR_JWT_SECRET_MIN_32_CHARS>
# Bearer token for agent-to-API authentication.
API_KEY=<YOUR_API_KEY>
# Admin token for read-only demo/admin endpoints (X-Admin-Token).
ADMIN_TOKEN=<YOUR_ADMIN_TOKEN>
# Allowed CORS origin for the dashboard/frontend.
FRONTEND_ORIGIN=http://localhost:3000

# --- EMAIL (SMTP) — password reset codes ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=archbusins@gmail.com
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
SMTP_FROM=archbusins@gmail.com
# Reset-code TTL + rate limit (security).
RESET_CODE_TTL_MIN=15
RESET_RATE_LIMIT_SEC=60

# --- P4 PLAN ENFORCEMENT (guardrails) ---
# Free plan daily trade cap (0 = unlimited but real-exec still blocked).
FREE_PLAN_DAILY_TRADE_CAP=3
# 0 = free users CANNOT broadcast real tx (safe default).
FREE_PLAN_ALLOW_REAL_EXECUTION=0

# --- ADMIN BYPASS (operator/owner) ---
# Comma-separated user IDs that bypass the plan gate on mainnet.
ADMIN_USER_IDS=
# Comma-separated wallet addresses whitelisted past SC guard (EIP-7702 EOAs).
ADMIN_WALLET_ADDRESSES=
# Gnosis Safe Transaction Service URL (optional, multisig vaults).
GNOSIS_SAFE_API_URL=

# --- REAL EXECUTION SAFETY ---
# 0 = safe mode (no broadcast). 1 = LIVE (broadcasts real signed tx).
AGENT_B_REAL_EXECUTION=0
# Dry-run gate: 1 = NEVER broadcast on mainnet.
AGENT_B_DRY_RUN=1
# Explicit double-check gate before ANY mainnet broadcast.
MAINNET_CONFIRM=0
# Strict slippage band for DEX swaps (bps). Enforced 50-100 (0.5%-1.0%).
AGENT_B_SWAP_SLIPPAGE_BPS=100
# Hard gas-price ceiling (Gwei). 0 = disable cap.
MAX_GAS_PRICE_GWEI=5

# --- AGENT A (scout / LLM brain) ---
# OpenAI-compatible base URL for Agent A inference (vLLM, OpenAI, TGI, etc).
AGENT_A_ENDPOINT=<YOUR_AGENT_A_ENDPOINT>
AI_API_KEY=<YOUR_AI_API_KEY>
AI_MODEL=<YOUR_AI_MODEL>
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=1024
# Scout thresholds.
AGENT_A_LLM_THRESHOLD=60
AGENT_A_MIN_LIQUIDITY_USD=5000
AGENT_A_MIN_PAIR_AGE_SECONDS=0
AGENT_A_MAX_PAIR_AGE_SECONDS=0
AGENT_A_BATCH_SIZE=10
AGENT_A_DEFAULT_USER_ID=1
AGENT_A_NARRATIVE_MAX_TOKENS=400
AGENT_A_NARRATIVE_TEMP=0.7

# --- AGENT B (execution guard) ---
AGENT_B_ENDPOINT=<YOUR_AGENT_B_ENDPOINT>
AGENT_B_MODEL=<YOUR_AGENT_B_MODEL>
AGENT_B_API_KEY=<YOUR_AGENT_B_API_KEY>
AGENT_B_TEMPERATURE=0.1
AGENT_B_MAX_TOKENS=1024
AGENT_B_CONCURRENCY=1
AGENT_B_MAX_TX_USD=0.50
AGENT_B_MODEL_AUTO_DISCOVER=0
AGENT_B_MODEL_DISCOVER_TIMEOUT=10
AGENT_B_SKIP_GOPLUS=0
AGENT_B_PROFIT_PCT=30
AGENT_B_TESTNET_ETH_WEI=1000000000000000

# --- OSINT & SECURITY (KEEP — critical) ---
# Farcaster real-time data ingestion.
NEYNAR_API_KEY=<YOUR_NEYNAR_API_KEY>
# Anti-rug / honeypot screening (Base mainnet chain 8453).
GOPLUS_API_URL=https://api.gopluslabs.io/api/v1/token_security/8453
GOPLUS_API_KEY=<YOUR_GOPLUS_API_KEY>
# Vector memory store path.
CHROMA_PATH=.chroma_db

# --- SPEND LIMITS ---
MAX_DAILY_SPEND_USD=50
MAX_TX_AMOUNT_USD=0.50

# --- TESTNET TOKEN FACTORY (A2Z test token) ---
A2Z_TESTNET_TOKEN=<YOUR_TESTNET_TOKEN_ADDRESS>
A2Z_TESTNET_TOKEN_NAME=A2ZTestToken
A2Z_TESTNET_TOKEN_TICKER=A2ZT
A2Z_TEST_ADDRESS=<YOUR_A2Z_TEST_ADDRESS>
TX_PREFIX=A2Z

# --- INFRASTRUCTURE ---
DEBUG=0
A2Z_PLATFORM=
