# A2Z Agentz Backend Environment Variables

# Database (PostgreSQL)
POSTGRES_URI=postgresql://a2z_user:a2z_password@localhost:5432/a2z_db?sslmode=disable

# Base Network
BASE_RPC_URL=https://mainnet.base.org
AGENT_B_PRIVATE_KEY=your_private_key_here

# APIs for Scraping (Agent A)
NEYNAR_API_KEY=your_neynar_api_key
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# AMD AI Workbench / AIM
AIM_ENDPOINT_URL=http://localhost:8080/v1/chat/completions

# Auth (JWT)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
FRONTEND_ORIGIN=http://localhost:3000
