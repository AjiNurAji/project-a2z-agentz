# ============================================================
# A2Z Agentz — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or expose real secrets.
# ============================================================

# --- DATABASE LAYER ---
# PostgreSQL connection string for the application (Docker stack resolves host via service name).
POSTGRES_URI=postgresql://a2z_admin:***@postgres:5432/a2z_transactions
POSTGRES_DB=a2z_transactions
POSTGRES_USER=a2z_admin
# Dedicated PostgreSQL password (injected into the postgres container).
POSTGRES_PASSWORD=<SECRET_f5b4b43e>

# --- BLOCKCHAIN NETWORK ---
# Multi-RPC fallback for Base Mainnet (rotates automatically if one fails).
# IMPORTANT: keep these as MAINNET endpoints only. Do NOT put a Sepolia URL
# in BASE_RPC_1..4 (the old config had RPC_1 pointing at Sepolia, which broke
# mainnet routing). All four must resolve to chainId 8453.
BASE_RPC_1=https://base-mainnet.g.alchemy.com/v2/<YOUR_KEY>
BASE_RPC_2=https://mainnet.base.org
BASE_RPC_3=https://rpc.ankr.com/base
BASE_RPC_4=https://base.drpc.org

# Testnet nodes for safe smart contract deployment and testing.
BASE_SEPOLIA_RPC_1=https://base-sepolia.g.alchemy.com/v2/<YOUR_KEY>
BASE_SEPOLIA_RPC_2=https://sepolia.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Active network selector used by routing logic.
#   base        -> Base Mainnet (chain 8453)
#   base_sepolia-> Base Sepolia (chain 84532, default for live demos)
ACTIVE_NETWORK=base_sepolia

# --- REAL ON-CHAIN EXECUTION (AGENT B) ---
# Master kill-switch for broadcasting REAL transactions.
#   0 = safe mode (no broadcast, mock/dry-run only)
#   1 = LIVE (Agent B will broadcast real signed tx to the chain)
# Default to 0 in production until you have verified VAULT_ADDRESS + budget.
AGENT_B_REAL_EXECUTION=0

# Recipient address for proof-of-execution micro-transfers.
# MUST be a clean EOA that accepts native ETH.
# DO NOT use an EIP-7702 delegated EOA (e.g. adityamlna.base.eth / 0xD471...)
# — it reverts on native value transfer on Base mainnet.
# Verified clean EOA (operator): 0xd6d824fd3d19e46b5e2046955d13e9fd42db79d3
VAULT_ADDRESS=0xd6d824fd3d19e46b5e2046955d13e9fd42db79d3

# Micro-transfer amount for the proof-of-execution receipt (in ETH).
MICRO_TX_ETH=0.00001

# Hard gas-price ceiling (Gwei). Broadcast is skipped if estimated maxFee
# exceeds this. Set 0 to disable the cap (not recommended).
MAX_GAS_PRICE_GWEI=5

# --- CRYPTO CREDENTIALS ---
# Hot wallet keys for automated on-chain execution and transaction signatures.
PRIVATE_KEY=0x<YOUR_PRIVATE_KEY>
AGENT_A_PUBLIC_KEY=0x<YOUR_PUBLIC_KEY>

# --- OSINT & SOCIAL SIGNALS ---
# Neynar API for real-time Farcaster data ingestion.
NEYNAR_API_KEY=<YOUR_NEYNAR_API_KEY>

# AI BRAIN (AGENT A) — AMD MI300X vLLM
# The backend reads AI_ENDPOINT (OpenAI-compatible base URL served by vLLM on ROCm).
# When using Cloudflare Quick Tunnel: https://<random-subdomain>.trycloudflare.com/v1
# Leave empty to disable Agent A inference (system-status reports "not_configured").
AI_ENDPOINT=
AI_API_KEY=<YOUR_VLLM_API_KEY>
AI_MODEL=Llama/Llama2.5-72B-Instruct-AWQ

# Legacy alias (kept for reference; AI_ENDPOINT takes precedence in code).
AGENT_A_ENDPOINT=
AGENT_A_MODEL=Llama/Llama2.5-72B-Instruct-AWQ
AGENT_A_API_KEY=<YOUR_VLLM_API_KEY_IF_REQUIRED>
AGENT_A_TEMPERATURE=0.0
AGENT_A_MAX_TOKENS=1024

# GUARDRAIL VALIDATOR (AGENT B)
# Secondary AI agent used as a final anti-hallucination check before execution.
AGENT_B_ENDPOINT=https://api.fireworks.ai/inference/v1
AGENT_B_MODEL=accounts/fireworks/models/deepseek-v4-flash
AGENT_B_API_KEY=<YOUR_AGENT_B_API_KEY>
AGENT_B_TEMPERATURE=0.1
AGENT_B_MAX_TOKENS=1024

# --- SECURITY GATES ---
# Anti-rug and honeypot security screening URL for Base Mainnet (Chain ID 8453).
GOPLUS_API_URL=https://api.gopluslabs.io/api/v1/token_security/8453
GOPLUS_API_KEY=<YOUR_GOPLUS_API_KEY>

# --- TRANSACTION SIMULATION ---
# Sandbox simulation keys for testing smart contract calls before hitting Mainnet.
TENDERLY_ACCESS_KEY=<YOUR_TENDERLY_ACCESS_KEY>
TENDERLY_ACCOUNT_SLUG=<YOUR_TENDERLY_ACCOUNT_SLUG>
TENDERLY_PROJECT_SLUG=<YOUR_TENDERLY_PROJECT_SLUG>

# --- AUTH & API SECURITY ---
# JWT signing secret (must be a strong random 32+ character string).
JWT_SECRET=<YOUR_JWT_SECRET_MIN_32_CHARS>
# Bearer token for agent-to-API authentication.
API_KEY=<YOUR_API_KEY>
# Judge token for read-only admin endpoints (hackathon judging access).
JUDGE_TOKEN=<YOUR_JUDGE_TOKEN>
# Allowed CORS origin for the dashboard/frontend.
FRONTEND_ORIGIN=http://localhost:3000

# --- ENGINE PARAMETERS ---
# Risk and spending guardrails.
BATCH_SIZE=10
MAX_TX_AMOUNT_USD=2.00
MAX_SPEND_PER_CYCLE_USD=10.00
MAX_DAILY_SPEND_USD=50.00
CONSECUTIVE_FAIL_LIMIT=3

# --- EXTERNAL DATA ---
# TVL / market data endpoint (if used by scoring logic).
TVL_ENDPOINT=https://<YOUR_TVL_API_ENDPOINT>

# --- LOCAL ENVIRONMENT SETTINGS ---
# Enable verbose debug logging (set to "false" in production).
DEBUG=true
