# --- DATABASE LAYER ---
# Local PostgreSQL storage using FIFO SKIP LOCKED for async worker queues
POSTGRES_URI=postgresql://a2z_admin:***@postgres:5432/a2z_transactions

# --- BLOCKCHAIN NETWORK ---
# Multi-RPC fallback switcher for Base Mainnet (rotates automatically if one fails)
BASE_RPC_1=https://base-mainnet.g.alchemy.com/v2/xxxxx
BASE_RPC_2=https://mainnet.base.org
BASE_RPC_3=https://rpc.ankr.com/base

# Testnet nodes for safe smart contract deployment and testing
BASE_SEPOLIA_RPC_1=https://base-sepolia.g.alchemy.com/v2/xxxx
BASE_SEPOLIA_RPC_2=https://sepolia.base.org

# --- CRYPTO CREDENTIALS ---
# Hot wallet keys for automated on-chain execution and transaction signatures
PRIVATE_KEY=xxx
AGENT_A_PUBLIC_KEY=xxxxxxxx

# --- OSINT & SOCIAL SIGNALS ---
# Neynar API for real-time Farcaster data ingestion, replacing heavy scraping tools
NEYNAR_API_KEY=xxxxx

# --- CENTRAL INTEL BRAIN (AGENT A) ---
# High-throughput SGLang server routed via secure SSH tunnel from the AMD MI300X cluster
AGENT_A_ENDPOINT=http://localhost:8080/v1
AGENT_A_MODEL=Qwen/Qwen2.5-72B-Instruct
AGENT_A_API_KEY=not-needed-for-sglang-native-unless-proxied

# --- GUARDRAIL VALIDATOR (AGENT B) ---
# Secondary AI agent used as a final anti-hallucination check before execution
AGENT_B_ENDPOINT=https://api.fireworks.ai/inference/v1
AGENT_B_MODEL=accounts/fireworks/models/deepseek-v4-flash
AGENT_B_API_KEY=xxxxx

# --- SECURITY GATES ---
# Anti-rug and honeypot security screening URL for Base Mainnet (Chain ID 8453)
GOPLUS_API_URL=https://api.gopluslabs.io/api/v1/token_security/8453
GOPLUS_API_KEY=xxxxxxxxx

# --- TRANSACTION SIMULATION ---
# Sandbox simulation keys for testing smart contract calls before hitting Mainnet
TENDERLY_ACCESS_KEY=xxxx
TENDERLY_ACCOUNT_SLUG=xxxx
TENDERLY_PROJECT_SLUG=xxxxx

# --- LOCAL ENVIRONMENT SETTINGS ---
# Security token for internal endpoints and local development origins
JWT_SECRET=super-secret-key-for-local-dev-only-32-chars
FRONTEND_ORIGIN=http://localhost:3000
API_KEY=test_api_key_123

# --- (Engine Solidification) ---
AGENT_A_DEX_Q=trending_tokens
AGENT_A_NEYNAR_LIMIT=50
AGENT_A_DEFAULT_USER_ID=your_farcaster_id_here
BASE_CHAIN_ID=8453
AGENT_B_AUTO_SCORE_MIN=85

