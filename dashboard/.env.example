# A2Z Agentz — Frontend environment (Vercel)
# Copy to .env.local for local dev. NEVER commit real values.

# Backend API (Railway). Absolute URL so cross-origin fetch works from localhost.
NEXT_PUBLIC_API_URL=https://project-a2z-agentz-production-dc3d.up.railway.app

# Infrastructure API key (X-API-Key). SAME value as backend API_KEY.
NEXT_PUBLIC_API_KEY=__SET_TO_BACKEND_API_KEY__

# Optional admin demo token (X-Admin-Token). Leave blank if unused.
NEXT_PUBLIC_ADMIN_TOKEN=

# WalletConnect v2 project id (from cloud.walletconnect.com / reown.com).
# REQUIRED for the WalletConnect (QR) login option. Get a free projectId there.
NEXT_PUBLIC_WC_PROJECT_ID=__SET_WC_PROJECT_ID__

# Optional Base RPC override used by WalletConnect provider.
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
